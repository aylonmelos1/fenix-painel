# Optional Cloudflare Worker proxy for Fênix upstream traffic.
# Leave both unset to connect directly to https://fenix.cbm.ba.gov.br.
# Use the Worker origin whose /api/v1/* route is configured to this proxy.
FENIX_BASE_URL=https://fenix-proxy.example.net
FENIX_PROXY_TOKEN=replace-with-the-worker-secret

# Web Push para avisos mesmo sem o painel aberto.
# Gere uma vez com: npx web-push generate-vapid-keys
# Mantenha o mesmo par de chaves entre deploys; trocar as chaves exige nova inscrição dos navegadores.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:suporte@example.com
