# Optional Cloudflare Worker proxy for Fênix upstream traffic.
# Leave both unset to connect directly to https://fenix.cbm.ba.gov.br.
# Use the Worker origin whose /api/v1/* route is configured to this proxy.
FENIX_BASE_URL=https://fenix-proxy.example.net
FENIX_PROXY_TOKEN=replace-with-the-worker-secret
